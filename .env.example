# Porta exposta no Host
PORT=3000

# PostgreSQL
POSTGRES_DB=app_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_secret_change_me
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# URLs de Conexão Interna (usando os nomes dos serviços como host DNS)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
REDIS_URL=redis://redis:${REDIS_PORT}